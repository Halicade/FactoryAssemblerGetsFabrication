<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<ThingDef ParentName="BuildingBase">
		<defName>MPE_HiTechAutomatedCannery</defName>
		<label>Hi-Tech autonomous cannery</label>
		<description>A hi-tech autonomous preserving system for the mass production of canned goods from various raw ingredients, requiring no manual labor.\n\nHi-Tech Factory buildings produce at two times the speed of industrial factories, as well as needing factory hoppers for input and output. They cool the environment and consume twice as much power, but can be overclocked for much higher efficiency, increasing power consumption and vastly decreasing local temperatures.</description>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Factories/HiTechAutomatedCannery/HiTechAutomatedCannery</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(4,6)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<thingCategories>
			<li>VFEFactory_FactoryCategory</li>
		</thingCategories>
		<costList>
			<Plasteel>270</Plasteel>
			<ComponentSpacer>4</ComponentSpacer>
		</costList>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<altitudeLayer>Building</altitudeLayer>
		<rotatable>true</rotatable>
		<neverMultiSelect>true</neverMultiSelect>
		<uiIconScale>0.8</uiIconScale>
		<fillPercent>0.5</fillPercent>
		<useHitPoints>True</useHitPoints>
		<statBases>
			<Mass>65</Mass>
			<Beauty>-10</Beauty>
			<WorkToBuild>10000</WorkToBuild>
			<MaxHitPoints>550</MaxHitPoints>
			<Flammability>1</Flammability>
			<VEF_BuildingMaxOverclockFactor>1</VEF_BuildingMaxOverclockFactor>
			<VEF_BuildingBreakdownFactor>3</VEF_BuildingBreakdownFactor>
		</statBases>
		<tickerType>Normal</tickerType>
		<size>(3,5)</size>
		<designationCategory>VFEFactory_Factories</designationCategory>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(0,0,-3)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<researchPrerequisites>
			<li>MPE_HiTechFactories</li>
			<li>VCE_Canning</li>
		</researchPrerequisites>
		<building>
			<relatedBuildCommands>
				<li>MPE_HiTechFactoryHopper</li>
			</relatedBuildCommands>
			<buildingTags>
				<li>Production</li>
			</buildingTags>
			<workTableRoomRole>VFEFactory_FactoryRoom</workTableRoomRole>
			<workTableNotInRoomRoleFactor>0.25</workTableNotInRoomRoleFactor>
		</building>
		<inspectorTabs>
			<li>PipeSystem.ITab_Processor</li>
		</inspectorTabs>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<shortCircuitInRain>true</shortCircuitInRain>
				<basePowerConsumption>920</basePowerConsumption>
			</li>
			<li>
				<compClass>PipeSystem.CompPowerTrader_Overclocked</compClass>
			</li>
			<li Class="CompProperties_HeatPusher">
				<compClass>PipeSystem.CompHeatPusherPowered_Overclocked</compClass>
				<heatPerSecond>-9</heatPerSecond>
				<heatPushMinTemperature>-66</heatPushMinTemperature>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
				<notWorkingKey>VFEFactory_FactoryNotWorking</notWorkingKey>
				<canOverclock>true</canOverclock>
				<overclockGizmo>UI/Gizmo/Factory_Overclock</overclockGizmo>
				<overclockLabel>VFEFactory_Overclock</overclockLabel>
				<overclockWindowLabel>VFEFactory_OverclockWindowLabel</overclockWindowLabel>
				<overclockDesc>VFEFactory_OverclockDesc</overclockDesc>
				<alwaysShowProgressBar>true</alwaysShowProgressBar>
				<processes>
					<li>VFEFactory_MakeCannedMeat</li>
					<li>VFEFactory_MakeCannedProduce</li>
					<li MayRequire="VanillaExpanded.VPlantsE">VFEFactory_MakeCannedFruit</li>
					<li>VFEFactory_MakeCannedEggs</li>
					<li MayRequire="Ludeon.RimWorld.Odyssey">VFEFactory_MakeCannedFish</li>
					<li>VFEFactory_MakeCannedSoup</li>
					<li MayRequire="VanillaExpanded.VBrewE">MPE_T2_EnergyDrinks</li>
				</processes>
				<hideSettings>true</hideSettings>
			</li>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
				</linkableFacilities>
			</li>
		</comps>
		<minifiedDef>MinifiedThing</minifiedDef>
	</ThingDef>

	<ThingDef ParentName="BuildingBase">
		<defName>MPE_SmartAutomatedCannery</defName>
		<label>smart cannery</label>
		<description>A smart autonomous preserving system for the mass production of canned goods from various raw ingredients, requiring no manual labor.\n\nSmart Factory buildings produce at four times the speed of industrial factories, as well as needing factory hoppers for input and output. They cool the environment and consume twice as much power, but can be overclocked for vastly higher efficiency, drastically increasing power consumption and vastly decreasing local temperatures. Due to dust contamination this factory must be constructed on sterile tiles.</description>
		<drawerType>MapMeshAndRealTime</drawerType>
		<graphicData>
			<texPath>Things/Building/Factories/SmartAutomatedCannery/SmartAutomatedCannery</texPath>
			<graphicClass>Graphic_Multi</graphicClass>
			<drawSize>(4,6)</drawSize>
			<damageData>
				<cornerTL>Damage/Corner</cornerTL>
				<cornerTR>Damage/Corner</cornerTR>
				<cornerBL>Damage/Corner</cornerBL>
				<cornerBR>Damage/Corner</cornerBR>
			</damageData>
		</graphicData>
		<thingCategories>
			<li>VFEFactory_FactoryCategory</li>
		</thingCategories>
		<costList>
			<Plasteel>270</Plasteel>
			<ComponentSpacer>8</ComponentSpacer>
		</costList>
		<constructionSkillPrerequisite>6</constructionSkillPrerequisite>
		<altitudeLayer>Building</altitudeLayer>
		<rotatable>true</rotatable>
		<neverMultiSelect>true</neverMultiSelect>
		<uiIconScale>0.8</uiIconScale>
		<fillPercent>0.5</fillPercent>
		<useHitPoints>True</useHitPoints>
		<statBases>
			<Mass>65</Mass>
			<Beauty>-10</Beauty>
			<WorkToBuild>20000</WorkToBuild>
			<MaxHitPoints>550</MaxHitPoints>
			<Flammability>1</Flammability>
			<VEF_BuildingMaxOverclockFactor>1</VEF_BuildingMaxOverclockFactor>
			<VEF_BuildingBreakdownFactor>4</VEF_BuildingBreakdownFactor>
		</statBases>
		<tickerType>Rare</tickerType>
		<size>(3,5)</size>
		<designationCategory>VFEFactory_Factories</designationCategory>
		<passability>PassThroughOnly</passability>
		<pathCost>50</pathCost>
		<hasInteractionCell>True</hasInteractionCell>
		<interactionCellOffset>(0,0,-3)</interactionCellOffset>
		<surfaceType>Item</surfaceType>
		<researchPrerequisites>
			<li>MPE_SmartFactories</li>
			<li>VCE_Canning</li>
		</researchPrerequisites>
		<building>
			<relatedBuildCommands>
				<li>MPE_SmartFactoryHopper</li>
			</relatedBuildCommands>
			<buildingTags>
				<li>Production</li>
			</buildingTags>
			<workTableRoomRole>VFEFactory_FactoryRoom</workTableRoomRole>
			<workTableNotInRoomRoleFactor>0.125</workTableNotInRoomRoleFactor>
		</building>
		<inspectorTabs>
			<li>PipeSystem.ITab_Processor</li>
		</inspectorTabs>
		<comps>
			<li Class="CompProperties_Power">
				<compClass>CompPowerTrader</compClass>
				<shortCircuitInRain>true</shortCircuitInRain>
				<basePowerConsumption>1840</basePowerConsumption>
			</li>
			<li>
				<compClass>PipeSystem.CompPowerTrader_Overclocked</compClass>
			</li>
			<li Class="CompProperties_HeatPusher">
				<compClass>PipeSystem.CompHeatPusherPowered_Overclocked</compClass>
				<heatPerSecond>-9</heatPerSecond>
				<heatPushMinTemperature>-66</heatPushMinTemperature>
			</li>
			<li Class="CompProperties_Flickable"/>
			<li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
				<notWorkingKey>VFEFactory_FactoryNotWorking</notWorkingKey>
				<canOverclock>true</canOverclock>
				<overclockGizmo>UI/Gizmo/Factory_Overclock</overclockGizmo>
				<overclockLabel>VFEFactory_Overclock</overclockLabel>
				<overclockWindowLabel>VFEFactory_OverclockWindowLabel</overclockWindowLabel>
				<overclockDesc>VFEFactory_OverclockDesc</overclockDesc>
				<alwaysShowProgressBar>true</alwaysShowProgressBar>
				<processes>
					<li>VFEFactory_MakeCannedMeat</li>
					<li>VFEFactory_MakeCannedProduce</li>
					<li MayRequire="VanillaExpanded.VPlantsE">VFEFactory_MakeCannedFruit</li>
					<li>VFEFactory_MakeCannedEggs</li>
					<li MayRequire="Ludeon.RimWorld.Odyssey">VFEFactory_MakeCannedFish</li>
					<li>VFEFactory_MakeCannedSoup</li>
				</processes>
				<hideSettings>true</hideSettings>
			</li>
			<li Class="CompProperties_AffectedByFacilities">
				<linkableFacilities>
					<li>MPE_MechUplink</li>
				</linkableFacilities>
			</li>
		</comps>
		<minifiedDef>MinifiedThing</minifiedDef>
	</ThingDef>
	
</Defs>
