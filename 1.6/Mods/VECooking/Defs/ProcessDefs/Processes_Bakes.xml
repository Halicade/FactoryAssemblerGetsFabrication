<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<!--
    How to set up recipe.
    Get original recipes filter category and count. 
    Multiply count by 20. That is countNeeded which goes in ingredients
    
    MassProductionExpansion.ModExtension.nutritionChanger
    nutritionToMake is total count
    Unlike other recipes the original recipe makes twice the amount.
    -->
    <PipeSystem.ProcessDef ParentName="MPE_GenericMealBase">
        <defName>MPE_T2_MakeSimpleBake</defName>
        <label>Make 8x simple bakes</label>
        <labelOverride>Make bulk simple bake</labelOverride>
        <description>Process a bulk batch of simple baked meals. A total of 2.4 nutrition will make 4 survival meals.</description>
        <priorityInBillList>2</priorityInBillList>
        <ticks>7200</ticks>
        <ingredients>
            <li>
                <thing>VCE_Flour</thing>
				<countNeeded>80</countNeeded>
            </li>
        </ingredients>
        <results>
            <li>
                <thing>VCE_SimpleBake</thing>
                <count>8</count>
                <workerClass>MassProductionExpansion.ResultWorker.Meals</workerClass>
            </li>
        </results>
        <researchPrerequisites>
            <li>MPE_HiTechFactories</li>
        </researchPrerequisites>
        <modExtensions>
            <li Class="MassProductionExpansion.ModExtension.nutritionChanger">
				<nutritionToMake>4</nutritionToMake>
            </li>
        </modExtensions>
    </PipeSystem.ProcessDef>

	<PipeSystem.ProcessDef ParentName="MPE_GenericMealBase">
		<defName>MPE_T2_MakeFineBake</defName>
		<label>Make 8 fine bakes</label>
		<labelOverride>Make bulk fine bake</labelOverride>
		<description>Process a bulk batch of fine baked meals. A total of 2.4 nutrition will make 4 survival meals.</description>
		<priorityInBillList>2</priorityInBillList>
		<ticks>10800</ticks>
		<ingredients>
			<li>
				<thingCategory>
					<li>MeatRaw</li>
				</thingCategory>
				<countNeeded>20</countNeeded>
			</li>
			<li>
				<thingCategory>
					<li>PlantFoodRaw</li>
				</thingCategory>
				<countNeeded>20</countNeeded>
			</li>
			<li>
				<thing>VCE_Flour</thing>
				<countNeeded>40</countNeeded>
			</li>
		</ingredients>
		<results>
			<li>
				<thing>VCE_FineBake</thing>
				<count>8</count>
				<workerClass>MassProductionExpansion.ResultWorker.Meals</workerClass>
			</li>
		</results>
		<researchPrerequisites>
			<li>MPE_HiTechFactories</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="MassProductionExpansion.ModExtension.nutritionChanger">
				<nutritionToMake>4</nutritionToMake>
			</li>
		</modExtensions>
	</PipeSystem.ProcessDef>
</Defs>