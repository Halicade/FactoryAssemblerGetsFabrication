<?xml version="1.0" encoding="utf-8"?>

<Defs>


    <PipeSystem.ProcessDef ParentName="MPE_GenericMealBase">
        <defName>MPE_T2_MakeSimpleGrill</defName>
        <label>Make 4x simple grill</label>
        <labelOverride>Make 4x simple grill</labelOverride>
        <description>Prepare 4x simple grills from meat. A total of 2.4 nutrition will make 4 grills.</description>
        <priorityInBillList>2</priorityInBillList>
        <ticks>4800</ticks>
        <ingredients>
            <li>
                <thingCategory>MeatRaw</thingCategory>
                <countNeeded>40</countNeeded>
            </li>
        </ingredients>
        <results>
            <li>
                <thing>VCE_SimpleGrill</thing>
                <count>4</count>
            </li>
        </results>
        <researchPrerequisites>
            <li>VCE_Grilling</li>
            <li>MPE_HiTechFactories</li>
        </researchPrerequisites>
    </PipeSystem.ProcessDef>

    <PipeSystem.ProcessDef ParentName="MPE_GenericMealBase">
