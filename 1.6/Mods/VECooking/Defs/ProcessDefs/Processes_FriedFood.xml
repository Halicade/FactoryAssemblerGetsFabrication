<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<PipeSystem.ProcessDef ParentName="MPE_GenericMealBase">
		<defName>MPE_T2_MakeFriedMeats</defName>
		<label>Make 10x fried meat</label>
		<labelOverride>Make fried meat</labelOverride>
		<description>Process a batch of fried meat. A total of 2.4 nutrition will make 4 grills.</description>
		<priorityInBillList>2</priorityInBillList>
		<ticks>2400</ticks>
		<ingredients>
			<li>
				<thingCategory>MeatRaw</thingCategory>
				<countNeeded>5</countNeeded>
				<disallowedThingDefs>
					<li>Meat_Human</li>
					<li>Meat_Megaspider</li>
					<li>VCE_DeepFriedBigMeat</li>
					<li>VCE_DeepFriedFish</li>
					<li MayRequire="Ludeon.RimWorld.Anomaly">Meat_Twisted</li>
					<li MayRequire="VanillaExpanded.VAEWaste">VAEWaste_ToxicMeat</li>
					<li MayRequire="VanillaExpanded.VCookESushi">VCE_HumanSurimi</li>
				</disallowedThingDefs>
			</li>
		</ingredients>
		<results>
			<li>
				<thing>VCE_DeepFriedBigMeat</thing>
				<count>20</count>
				<workerClass>MassProductionExpansion.ResultWorker.Meals</workerClass>
				<outputStringOverride>VFEFactory_SurvivalMealOutput</outputStringOverride>
			</li>
		</results>
		<researchPrerequisites>
			<li>VCE_DeepFrying</li>
			<li>MPE_HiTechFactories</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="MassProductionExpansion.ModExtension.nutritionChanger">
				<nutritionToMake>2</nutritionToMake>
			</li>
		</modExtensions>
	</PipeSystem.ProcessDef>

	<PipeSystem.ProcessDef ParentName="MPE_GenericMealBase">
		<defName>MPE_T2_MakeFriedVegetables</defName>
		<label>Make 10x fried vegetables</label>
		<labelOverride>Make fried vegetables</labelOverride>
		<description>Process a batch of fried vegetables. A total of 2.4 nutrition will make 4 grills.</description>
		<priorityInBillList>2</priorityInBillList>
		<ticks>2400</ticks>
		<ingredients>
			<li>
				<thingCategory>PlantFoodRaw</thingCategory>
				<countNeeded>5</countNeeded>
				<disallowedThingDefs>
					<li>VCE_DeepFriedVegetables</li>
				</disallowedThingDefs>
			</li>
		</ingredients>
		<results>
			<li>
				<thing>VCE_DeepFriedVegetables</thing>
				<count>10</count>
				<workerClass>MassProductionExpansion.ResultWorker.Meals</workerClass>
				<outputStringOverride>VFEFactory_SurvivalMealOutput</outputStringOverride>
			</li>
		</results>
		<researchPrerequisites>
			<li>VCE_DeepFrying</li>
			<li>MPE_HiTechFactories</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="MassProductionExpansion.ModExtension.nutritionChanger">
				<nutritionToMake>2</nutritionToMake>
			</li>
		</modExtensions>
	</PipeSystem.ProcessDef>
</Defs>