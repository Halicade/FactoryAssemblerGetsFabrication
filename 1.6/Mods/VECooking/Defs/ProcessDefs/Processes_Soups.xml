<?xml version="1.0" encoding="utf-8"?>
<Defs>

	<PipeSystem.ProcessDef ParentName="MPE_GenericMealBase">
		<defName>MPE_T2_MakeFineUncookedSoup</defName>
		<label>Make 4x fine uncooked soup</label>
		<labelOverride>Make 4x fine uncooked soup</labelOverride>
		<description>Prepare 4x simple grills from meat. A total of 2.4 nutrition will make 4 grills.</description>
		<priorityInBillList>2</priorityInBillList>
		<ticks>7200</ticks>
		<ingredients>
			<li>
				<thingCategory>MeatRaw</thingCategory>
				<countNeeded>2</countNeeded>
			</li>
			<li>
				<thingCategory>PlantFoodRaw</thingCategory>
				<countNeeded>2</countNeeded>
			</li>
		</ingredients>
		<results>
			<li>
				<thing>VCE_UncookedSoupFine</thing>
				<count>4</count>
				<workerClass>MassProductionExpansion.ResultWorker.Meals</workerClass>
				<outputStringOverride>VFEFactory_SurvivalMealOutput</outputStringOverride>
			</li>
		</results>
		<researchPrerequisites>
			<li>VCE_SoupCooking</li>
			<li>MPE_HiTechFactories</li>
		</researchPrerequisites>
		<modExtensions>
			<li Class="MassProductionExpansion.ModExtension.nutritionChanger">
				<nutritionToMake>2</nutritionToMake>
			</li>
		</modExtensions>
	</PipeSystem.ProcessDef>
    
</Defs>