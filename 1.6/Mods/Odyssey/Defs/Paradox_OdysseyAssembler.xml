<?xml version="1.0" encoding="utf-8"?>

<Defs>

    <ThingDef ParentName="BuildingBase">
        <defName>MPE_GravtechAssembler</defName>
        <label>Gravtech Assembler</label>
        <description>A microfactory utilizing gravcore technology for assembling, machining and tailoring any number of goods, primarily designed for compact spacecraft where real estate is valuable and hard to come by.\n\nThis assembler can produce a number of goods at a high speed and allows for overclocking, increasing power consumption and vastly decreasing local temperatures. Due to dust contamination this factory must be constructed on sterile tiles.</description>
        <drawerType>MapMeshAndRealTime</drawerType>
        <graphicData>
            <texPath>Things/Building/OdysseyAssembler/OdysseyAssembler</texPath>
            <graphicClass>Graphic_Multi</graphicClass>
            <drawSize>(3,3)</drawSize>
            <damageData>
                <cornerTL>Damage/Corner</cornerTL>
                <cornerTR>Damage/Corner</cornerTR>
                <cornerBL>Damage/Corner</cornerBL>
                <cornerBR>Damage/Corner</cornerBR>
            </damageData>
        </graphicData>
        <thingCategories>
            <li>VFEFactory_FactoryCategory</li>
        </thingCategories>
        <costList>
            <Plasteel>500</Plasteel>
            <ComponentSpacer>20</ComponentSpacer>
            <Gravcore>3</Gravcore>
        </costList>
        <constructionSkillPrerequisite>6</constructionSkillPrerequisite>
        <altitudeLayer>Building</altitudeLayer>
        <terrainAffordanceNeeded>MPE_SterileTile</terrainAffordanceNeeded>
        <rotatable>true</rotatable>
        <neverMultiSelect>true</neverMultiSelect>
        <uiIconScale>0.8</uiIconScale>
        <fillPercent>0.5</fillPercent>
        <useHitPoints>True</useHitPoints>
        <statBases>
            <Mass>60</Mass>
            <Beauty>-10</Beauty>
            <WorkToBuild>5000</WorkToBuild>
            <MaxHitPoints>450</MaxHitPoints>
            <Flammability>1</Flammability>
            <VEF_BuildingBreakdownFactor>1</VEF_BuildingBreakdownFactor>
            <VEF_BuildingMaxOverclockFactor>5</VEF_BuildingMaxOverclockFactor>
        </statBases>
        <tickerType>Rare</tickerType>
        <size>(3,3)</size>
        <designationCategory>VFEFactory_Factories</designationCategory>
        <passability>PassThroughOnly</passability>
        <pathCost>50</pathCost>
        <hasInteractionCell>True</hasInteractionCell>
        <interactionCellOffset>(0,0,-2)</interactionCellOffset>
        <surfaceType>Item</surfaceType>
        <researchPrerequisites>
            <li>MPE_SmartFactories</li>
            <li>AdvancedGravtech</li>
        </researchPrerequisites>
        <building>
            <relatedBuildCommands>
                <li>MPE_SmartFactoryHopper</li>
            </relatedBuildCommands>
            <buildingTags>
                <li>Production</li>
            </buildingTags>
            <workTableRoomRole>VFEFactory_FactoryRoom</workTableRoomRole>
            <workTableNotInRoomRoleFactor>0.8</workTableNotInRoomRoleFactor>
        </building>
        <inspectorTabs>
            <li>PipeSystem.ITab_Processor</li>
        </inspectorTabs>
        <comps>
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <shortCircuitInRain>true</shortCircuitInRain>
                <basePowerConsumption>3000</basePowerConsumption>
            </li>
            <li>
                <compClass>PipeSystem.CompPowerTrader_Overclocked</compClass>
            </li>
            <li Class="CompProperties_HeatPusher">
                <compClass>PipeSystem.CompHeatPusherPowered_Overclocked</compClass>
                <heatPerSecond>-9</heatPerSecond>
                <heatPushMinTemperature>-66</heatPushMinTemperature>
            </li>
            <li Class="CompProperties_Flickable" />
            <li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
                <notWorkingKey>VFEFactory_FactoryNotWorking</notWorkingKey>
                <canOverclock>true</canOverclock>
                <overclockGizmo>UI/Gizmo/Factory_Overclock</overclockGizmo>
                <overclockLabel>VFEFactory_Overclock</overclockLabel>
                <overclockWindowLabel>VFEFactory_OverclockWindowLabel</overclockWindowLabel>
                <overclockDesc>VFEFactory_OverclockDesc</overclockDesc>
                <alwaysShowProgressBar>true</alwaysShowProgressBar>
                <processes>
                </processes>
                <hideSettings>true</hideSettings>
            </li>
            <li Class="CompProperties_AffectedByFacilities">
                <linkableFacilities>
                    <li>MPE_MechUplink</li>
                </linkableFacilities>
            </li>
        </comps>
        <minifiedDef>MinifiedThing</minifiedDef>
    </ThingDef>

</Defs>